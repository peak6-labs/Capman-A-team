# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Kalshi API credentials (create at https://kalshi.com/account/profile -> API Keys)
KALSHI_API_KEY_ID=your-key-id-uuid
# Path to the RSA private key PEM. IMPORTANT: this repo is SHARED — keep the private
# key OUTSIDE the repo tree (e.g. ~/.config/kalshi-agent-trader/) and use an absolute path.
KALSHI_PRIVATE_KEY_PATH=/Users/you/.config/kalshi-agent-trader/kalshi_private_key.pem

# Anthropic API key for the LLM agents (Phase 5)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the API base (prod default shown). Set to demo for paper testing.
# KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
